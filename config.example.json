{
  "version": 1,
  "connections": [
    {
      "name": "analytics",
      "project_id": "example-gcp-project",
      "location": "US",
      "credentials_file_env": "BQREST_ANALYTICS_CREDENTIALS_FILE",
      "datasets": ["published_insights"],
      "resources": [
        {
          "dataset": "published_insights",
          "table": "monthly_revenue",
          "enabled_columns": ["month", "revenue"]
        }
      ],
      "limits": {
        "max_bytes_billed": 5000000000,
        "max_page_rows": 10000,
        "max_response_bytes": 10000000
      }
    }
  ],
  "callers": [
    {
      "name": "reporting-service",
      "token_env": "BQREST_REPORTING_TOKEN",
      "allowed_connections": ["analytics"]
    }
  ]
}
